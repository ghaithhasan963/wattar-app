{
  "expo": {
    "name": "Wattar",
    "slug": "wattar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/wattar-icon.png",
    "scheme": "wattar",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.wattar.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "نحتاج الميكروفون للغرف الصوتية",
        "NSPhotoLibraryUsageDescription": "نحتاج الصور لرفع إثبات الشحن ومشاركة القصص"
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/wattar-adaptive-icon.png",
        "backgroundColor": "#090611"
      },
      "package": "app.wattar.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-notifications",
      "expo-web-browser",
      "expo-status-bar",
      "./plugins/withFirebaseAndroidSetup",
      "@livekit/react-native-expo-plugin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/wattar-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "useLegacyPackaging": true
          }
        }
      ],
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1e2581fe-f321-4cac-994f-c4a596b8d4db"
      }
    },
    "owner": "ghaettg"
  }
}
