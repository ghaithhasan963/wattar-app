# Wattar Edge Functions — environment template
# Copy to .env only for local `supabase functions serve`. Never commit .env.
# Production values are set with: npx supabase secrets set --env-file .env
# Do NOT put these values in the mobile app or admin panel.

# Supabase (auto-injected in hosted Edge Functions; required for local serve)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# LiveKit (server-side only)
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Password reset deep link used by admin-reset-user-password
ADMIN_PASSWORD_RESET_REDIRECT_URL=wattar://reset-password
